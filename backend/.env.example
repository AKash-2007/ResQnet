# ResQnet Backend Environment Configuration
PROJECT_NAME="ResQnet"
ENVIRONMENT="development"

# PostgreSQL + PostGIS Connection
# For local Docker: postgresql+asyncpg://resqnet:resqnet_secret@localhost:5432/resqnet_db
DATABASE_URL="postgresql+asyncpg://resqnet:resqnet_secret@localhost:5432/resqnet_db"
SYNC_DATABASE_URL="postgresql://resqnet:resqnet_secret@localhost:5432/resqnet_db"

POSTGRES_USER="resqnet"
POSTGRES_PASSWORD="resqnet_secret"
POSTGRES_DB="resqnet_db"
POSTGRES_PORT=5432

# Security & JWT (Generate with `openssl rand -hex 32`)
JWT_SECRET="replace_with_a_secure_random_secret_minimum_32_chars_long"
JWT_REFRESH_SECRET="replace_with_a_secure_refresh_secret_minimum_32_chars_long"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Geospatial Settings (in meters)
DEFAULT_RADIUS_METERS=1000
COMPACT_RADIUS_METERS=500
PRIVACY_MIN_COUNT_THRESHOLD=3

# Firebase Cloud Messaging (FCM)
FCM_SERVER_KEY="your_firebase_server_key_or_service_account_path"

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
